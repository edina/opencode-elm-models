{
  "name": "opencode-elm-models",
  "version": "1.0.0",
  "description": "OpenCode V2 provider plugin for University of Edinburgh ELM-hosted models.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edina/opencode-elm-models.git"
  },
  "bugs": {
    "url": "https://github.com/edina/opencode-elm-models/issues"
  },
  "homepage": "https://github.com/edina/opencode-elm-models#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "elm",
    "qwen",
    "university-of-edinburgh"
  ],
  "author": "EDINA, University of Edinburgh",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.4",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.4",
    "effect": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "opencode-elm-models": "git+https://git.ecdf.ed.ac.uk/s2703496/opencode-elm-models#main"
  }
